{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mixch-archive-admin",
  "main": "src/index.js",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "preview_urls": false,
  // 起動記録が出ない旧設定を更新。5分間隔は維持し、毎時1・6・11…56分に起動します。
  "triggers": { "crons": ["1,6,11,16,21,26,31,36,41,46,51,56 * * * *"] },
  // 静的アセット用の内部ルーターを使わず、HTMLを文字列として同梱します。
  // HTMLも認証処理を通して配信します。
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "20840908",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  }
  // GITHUB_TOKENとADMIN_PASSWORDはCloudflareのSecretに保存します。
}
